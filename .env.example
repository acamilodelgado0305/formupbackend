# URL de conexion a MongoDB (MongoDB Compass / local)
MONGODB_URI=mongodb://127.0.0.1:27017/formup

# Puerto del servidor backend
PORT=4000

# Secreto para firmar los JWT (cambiar en produccion)
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRES_IN=8h

# Credenciales para el script de creacion del usuario administrador
ADMIN_EMAIL=admin@formup.edu.co
ADMIN_PASSWORD=CambiaEstaClave123

# Origen(es) permitido(s) para CORS: la URL del FRONTEND, no la del backend.
# Acepta varios separados por coma.
# En Vercel (proyecto del backend): CLIENT_ORIGIN=https://formupfrontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173
